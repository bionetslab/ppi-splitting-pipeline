plugins {
    id 'nf-schema@2.7.2'
}

// Params live in conf/params.config so an embedding pipeline can include them
includeConfig 'conf/params.config'

process {
    cpus   = 1
    memory = '4 GB'
    time   = '2 h'
    maxRetries = 1

    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }

    // Gurobi (WLS/floating) licenses cap concurrent sessions -- cap our own
    // concurrency to that limit and back off before retrying so a transient
    // "too many sessions" failure doesn't abort the whole run.
    withLabel:gurobi {
        maxForks     = 2
        beforeScript = { task.attempt > 1 ? "sleep ${task.attempt * 30}" : '' }
    }

    withName: 'FETCH_DATA' {
        cpus   = 1
        memory = '4 GB'
        time   = '6 h'
    }

    withName: 'FETCH_DOMAIN_META' {
        cpus   = 1
        // Holds the UniProt universe in RAM; more strata or a TrEMBL file need more.
        memory = '12 GB'
        time   = '6 h'
    }

    withName: 'RUN_BLAST' {
        cpus   = 64
        memory = '32 GB'
        time   = '12 h'
    }
    withName: 'RUN_KAHIP' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }
    withName: 'CDHIT2D' {
        cpus   = 4
        memory = '8 GB'
        time   = '4 h'
    }
    withName: 'EMBED_SEQUENCES' {
        memory = '32 GB'
        time   = '12 h'
    }

    withName: 'TRAIN_CLASSIFIER' {
        memory = { 60.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'BIAS_ANALYSIS' {
        memory = { 60.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'SOLVE_ILP' {
        cpus   = 10
        memory = '32 GB'
        time   = '4 h'
    }

    withName: 'SELECT_EXAMPLES' {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'SAMPLE_NEGATIVES_ILP' {
        cpus   = 8
        memory = '16 GB'
        time   = { 6.h * task.attempt }
    }

    withName: 'SAMPLE_NEGATIVES_DEGREE' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: 'MULTIQC' {
        memory = '16 GB'
    }
}

profiles {
    // Standalone runs only ($projectDir/bin); embedding pipelines use the docker profile.
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }

    // :latest is the newest release and carries its bin/; pin a release tag to run an older checkout.
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.container = 'ghcr.io/bionetslab/ppi-splitting-pipeline:latest'
    }

    singularity {
        singularity.enabled     = true
        singularity.pullTimeout = '2 h'
        process.container       = 'ghcr.io/bionetslab/ppi-splitting-pipeline:latest'
    }

    apptainer {
        apptainer.enabled     = true
        apptainer.pullTimeout = '2 h'
        process.container     = 'ghcr.io/bionetslab/ppi-splitting-pipeline:latest'
    }

    slurm {
        process.executor = 'slurm'
    }

    test {
        params.samplesheet = "${projectDir}/assets/samplesheet_test.csv"
        params.outdir       = "${projectDir}/results/results_test"
        process {
            resourceLimits = [
                cpus: 4,
                memory: '3.GB',
                time: '1.h'
            ]
        }
    }
}
