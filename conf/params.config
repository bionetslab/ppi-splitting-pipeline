// Every pipeline parameter. Kept out of nextflow.config so a pipeline embedding PPI_SPLITTING
// can includeConfig it; must not reference projectDir.

params {
    samplesheet            = "samplesheet.csv"
    outdir                 = "results"
    // Best-practice short run: skip FETCH_DATA/CLUSTERING/TRAIN_BASELINE/QC entirely. Every dataset must supply
    // sequences/go_annotations/species (--ddi_mode: domain_instances for GO) and a precomputed partition/node_mapping.
    split_only             = false
    // Shortcut for running just the bias diagnostics: supply train/val/test splits, BLAST hits, embeddings, GO
    // annotations, and species files.
    bias_only              = false
    embedding_model        = "esm2"  // "none" (one-hot), "esm2", "prot_t5", or path to pre-computed .npz
    cdhit_identity         = 0.4
    cdhit_wordsize         = 2
    seed                   = 42
    heatmap_max_per_split  = 500
    // Splitting method: "kahip" (default), "ilp", or "random" (naive baseline, see README)
    split_method           = "kahip"
    // Kahip parameters
    edge_weight            = "normalized_bitscore"  // "bitscore" or "normalized_bitscore"
    kahip_seed             = 1234
    kahip_k                = 3
    kahip_preconfiguration = "strong"
    // ILP parameters
    ilp_kahip_k            = 100  // number of KaHIP partitions ("clusters") fed into the ILP
    train_split            = 0.8
    val_split              = 0.1
    test_split             = 0.1
    ilp_epsilon            = 0.05
    ilp_max_sec            = 7200
    ilp_solver             = "GUROBI"
    gurobi_license         = "gurobi.lic"  // path to a gurobi.lic (e.g. WLS) file, only needed if --ilp_solver GUROBI
    // Negative sampling method: "default" (SAMPLE_NEGATIVES_DEGREE), "ilp" (SAMPLE_NEGATIVES_ILP),
    // "ilp_candidates" (SAMPLE_NEGATIVES_ILP restricted to the row's candidate_network pool),
    // or "uniform" (SAMPLE_NEGATIVES_DEGREE, uniform negatives for every split -- naive baseline, see README).
    // A comma-separated list ("ilp,ilp_candidates") draws several negative sets from one positive split.
    negative_sampling_method = "default"
    neg_ilp_lambda_degree    = 1.0
    neg_ilp_lambda_taxon_pair = 1.0
    neg_ilp_lambda_self_loop = 1.0
    neg_ilp_lambda_jaccard   = 1.0
    neg_ilp_solver           = "auto"     // "auto", "gurobi", "scip", or "highs"
    neg_ilp_time_limit       = 7200
    neg_ilp_mip_gap          = 0.01
    go_exclude_evidence      = "IPI,IGI"  // GO evidence codes dropped from go_annotations.tsv; "" keeps every annotation
    mqc_order                = []    // MultiQC dataset order by display label (list or "a,b"); [] = alphabetical
    // DDI mode: protein1/protein2 hold Pfam family accessions instead of proteins
    ddi_mode                 = false // route DATA_PREP through DATA_PREP_DDI
    ddi_examples_target      = 5     // N: instance-pair examples per DDI
    ddi_examples_pool_factor = 5     // M = N * this: instances sampled per family
    // SELECT_EXAMPLES (also uses ilp_solver/gurobi_license)
    ddi_select_max_sec       = 300   // seconds, total across all components
    ddi_max_ilp_candidates   = 200000 // a component larger than this skips the ILP for the greedy fallback
    ddi_lambda_diversity     = 0.1   // parent-reuse penalty; must stay < 0.5
    ddi_shortlist_factor     = 4     // cap a DDI's candidate pool at this * N before the ILP
    ddi_select_verbose       = false // let the SELECT_EXAMPLES solver print its own log to .command.err
    ddi_candidate_factor     = 4     // cap candidate_network pairs per split at this * the split's DDI count
    instance_tiers           = "human_reviewed" // strata to sample, any of human_reviewed,other_reviewed,human_unreviewed,other_unreviewed (unreviewed needs TrEMBL in uniprot_dat)
    interpro_cache           = null  // directory for cached Pfam/UniProt downloads; must be shared across compute nodes
    pfam_regions             = null  // local Pfam-A.regions.tsv.gz, skipping the download
    uniprot_dat              = null  // UniProt flat file(s), list or comma-separated, Swiss-Prot first; Swiss-Prot is downloaded when unset
    pfam_clans               = null  // local Pfam-A.clans.tsv(.gz), skipping that download
    pfam_release             = null  // pin the Pfam release instead of downloading Pfam.version
}
