%%metro font_scale: 1.3
%%metro track_gap: 1
%%metro mode: light
%%metro style: seqera
%%metro line: pos_random_neg_random | Maximally biased | #ffb000
%%metro line: pos_kahip_neg_random | Similarity-reduced | #fe6100
%%metro line: pos_ilp_neg_random | ILP split | #dc267f
%%metro line: pos_ilp_neg_ilp | ILP split + ILP sampling | #785ef0
%%metro grid: data_prep | 0,0
%%metro grid: clustering | 1,0
%%metro grid: split_positives | 2,0
%%metro grid: sample_negatives | 3,0
%%metro grid: train_baseline | 1,1
%%metro grid: qc | 2,1

graph LR
    subgraph data_prep [Data Prep]
        fetch_data([Fetch Data])
    end

    subgraph clustering [Similarity-based partitioning]
        run_blast([Run BLAST])
        make_metis([Make METIS])
        run_kahip_k3([Run KaHIP (k=3)])
        run_kahip_k100([Run KaHIP (k=100)])

        run_blast -->|pos_kahip_neg_random| make_metis
        run_blast -->|pos_ilp_neg_random| make_metis
        run_blast -->|pos_ilp_neg_ilp| make_metis

        make_metis -->|pos_kahip_neg_random| run_kahip_k3
        make_metis -->|pos_ilp_neg_random| run_kahip_k100
        make_metis -->|pos_ilp_neg_ilp| run_kahip_k100
    end

    subgraph split_positives [Split Positives]
        solve_ilp([Solve ILP])
        sort_ppis([Sort PPIs])
        split_random([Split Random])
        cdhit2d([CD-HIT-2D])

        sort_ppis -->|pos_kahip_neg_random| cdhit2d
        solve_ilp -->|pos_ilp_neg_random| cdhit2d
        solve_ilp -->|pos_ilp_neg_ilp| cdhit2d

    end

    subgraph sample_negatives [Sample Negatives]
    	sample_negatives_uniform([Random, uniform])
    	sample_negatives_degree([Random, degree-preserving or uniform])
        sample_negatives_ilp([Solve ILP for bias-minimization])
    end

    subgraph train_baseline [Train Baseline]
        embed_sequences([Embed Sequences])
        train_classifier([Train Classifier])

        embed_sequences -->|pos_kahip_neg_random| train_classifier
        embed_sequences -->|pos_ilp_neg_random| train_classifier
        embed_sequences -->|pos_ilp_neg_ilp| train_classifier
        embed_sequences -->|pos_random_neg_random| train_classifier
    end

    subgraph qc [QC]
        bias_analysis([Bias Analysis])
        multiqc([MultiQC Report])

        bias_analysis -->|pos_kahip_neg_random| multiqc
        bias_analysis -->|pos_ilp_neg_random| multiqc
        bias_analysis -->|pos_ilp_neg_ilp| multiqc
        bias_analysis -->|pos_random_neg_random| multiqc
    end


    %% Inter-section edges
    fetch_data -->|pos_kahip_neg_random| run_blast
    fetch_data -->|pos_ilp_neg_random| run_blast
    fetch_data -->|pos_ilp_neg_ilp| run_blast

    fetch_data -->|pos_random_neg_random| split_random
    run_kahip_k3 -->|pos_kahip_neg_random| sort_ppis
    run_kahip_k100 -->|pos_ilp_neg_random| solve_ilp
    run_kahip_k100 -->|pos_ilp_neg_ilp| solve_ilp

    cdhit2d -->|pos_kahip_neg_random| sample_negatives_degree
    cdhit2d -->|pos_ilp_neg_random| sample_negatives_degree
    cdhit2d -->|pos_ilp_neg_ilp| sample_negatives_ilp
    split_random -->|pos_random_neg_random| sample_negatives_uniform
    cdhit2d -->|pos_kahip_neg_random| sample_negatives_uniform
    cdhit2d -->|pos_ilp_neg_random| sample_negatives_uniform
    cdhit2d -->|pos_ilp_neg_ilp| sample_negatives_uniform

    sample_negatives_uniform -->|pos_kahip_neg_random| embed_sequences
    sample_negatives_uniform -->|pos_ilp_neg_random| embed_sequences
    sample_negatives_uniform -->|pos_ilp_neg_ilp| embed_sequences

    sample_negatives_degree -->|pos_kahip_neg_random| embed_sequences
    sample_negatives_degree -->|pos_ilp_neg_random| embed_sequences
    sample_negatives_uniform -->|pos_random_neg_random| embed_sequences
    sample_negatives_ilp -->|pos_ilp_neg_ilp| embed_sequences

    embed_sequences -->|pos_kahip_neg_random| bias_analysis
    embed_sequences -->|pos_ilp_neg_random| bias_analysis
    embed_sequences -->|pos_ilp_neg_ilp| bias_analysis
    embed_sequences -->|pos_random_neg_random| bias_analysis
