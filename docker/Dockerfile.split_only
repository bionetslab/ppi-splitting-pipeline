# Smaller image for `--split_only` runs. It has no bin/, so it only works standalone:
#   nextflow run main.nf --samplesheet s.csv --split_only \
#       -with-docker ghcr.io/bionetslab/ppi-splitting-pipeline-split-only:latest
# Covers GET_LENGTHS, SORT_PPIS, SOLVE_ILP, CDHIT2D, REMOVE_REDUNDANT,
# SAMPLE_NEGATIVES_ILP and SAMPLE_NEGATIVES_DEGREE.

# pixi.lock's split-only env is the only package source; do not add packages here.
FROM ghcr.io/prefix-dev/pixi:0.67.1-bookworm-slim AS build
WORKDIR /app
COPY pixi.toml pixi.lock ./
RUN pixi install --locked -e split-only

# Only the env is copied over, at the same path (conda envs are not relocatable).
FROM debian:bookworm-slim
# procps: Nextflow's trace polling. ca-certificates: Gurobi WLS license check-out.
RUN apt-get update \
 && apt-get install -y --no-install-recommends procps ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/.pixi/envs/split-only /app/.pixi/envs/split-only
ENV CONDA_PREFIX=/app/.pixi/envs/split-only
ENV PATH=/app/.pixi/envs/split-only/bin:$PATH
